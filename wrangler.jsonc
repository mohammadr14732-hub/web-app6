{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app6",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9e7d264b-5dc9-43dd-91cb-0a6952fe42cc","database_name": "web-app6" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "42c237e4249b4f22bbaf78b66af17430" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
